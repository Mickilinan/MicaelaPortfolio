@inject ProjectService ProjectService
@inject IJSRuntime JSRuntime

<ProjectGridBase>
    <section class="featured-projects" data-aos="fade-up">
        <h2 class="section-title">Featured Projects</h2>
        <div class="projects-grid">
            @foreach (var project in ProjectService.GetFeaturedProjects().Take(3))
            {
                <ProjectCard Project="project" 
                            AosDelay="100" 
                            MaxTechnologies="10"
                            OnProjectClick="OpenProject" />
            }
        </div>
    </section>
</ProjectGridBase>

<ProjectModal Project="selectedProject" IsVisible="isModalVisible" OnClose="CloseModal" />

@code {
    private Project? selectedProject;
    private bool isModalVisible = false;

    private async Task OpenProject(Project project)
    {
        if (project.Screenshots?.Any() == true)
        {
            selectedProject = project;
            isModalVisible = true;
        }
        else
        {
            string urlToOpen = !string.IsNullOrEmpty(project.LiveUrl) ? project.LiveUrl : project.GitHubUrl;
            if (!string.IsNullOrEmpty(urlToOpen))
            {
                await JSRuntime.InvokeVoidAsync("open", urlToOpen, "_blank");
            }
        }
    }

    private void CloseModal()
    {
        selectedProject = null;
        isModalVisible = false;
    }
}
