@page "/about"
@inject IJSRuntime JS



<PageTitle>About | Micaela Nilsson</PageTitle>

<div class="page-header">
   
    <h1>Get to know me better</h1>
</div>

<section class="about-section">
    <div class="about-grid">
        <div class="about-image" data-aos="fade-right">
            <img src="/images/ishallen.jpg" alt="Micaela Nilsson" />
        </div>

        <div class="about-content" data-aos="fade-left">
           <div class="about-text">
                <p>
                    I came to development for the problem-solving and stayed for how creative
                    it turns out to be.</p>
                    <p> Seriously, watching a project grow, from the first lines of code to the final look
                    on the screen, feels really awesome. Whether it's designing user-friendly stuff in the frontend or
                    building the logic behind the scenes in the backend, I love the process of turning ideas into
                    something real.</p>
             

                <p>
                    I'm driven by curiosity and a habit of asking why. I believe careful
                    analysis is what separates code that works from code that holds up, and
                    I ask questions early rather than guessing. <br>During my internship at
                    Akribian I worked in an agile team and went deep into React and
                    TypeScript. It showed me how much of good software comes down to how
                    well a team works together.
                </p>

                <p>
                    For the past year I've been building Kattmatch alongside full-time work.
                    It's a cat adoption platform now in production and used by Swedish catrescue
                    organizations, and I've handled every part of it myself, from database
                    design and the security model to deployment and monitoring. It has taught
                    me as much about running software as about writing it.
                </p>

                <p>
                    <span class="accent">What about my future goals?</span><br> Well, I'm super excited to use my growing skills in a team where I can
                    keep learning and growing. I'm looking forward to taking on new challenges, working with others on
                    exciting projects and in the end, building things that make a difference.<br> I also want to stay up-to-date with all the new tech that's coming out – because let's be
                    honest, in this field, there's always something new and exciting to discover!
                </p>

                <p>
                    When I'm not coding , you'll probably find me enjoying nature and
                    animals. I really believe in having a good balance in life and for me that often means doing some
                    yoga, a bit of meditation or just letting loose and dancing.<br>
                    Who knew that finding your inner peace could also make you a more focused developer? Maybe it's the flexibility of mind – or maybe it's
                    just a good way to chill out after dealing with a stubborn bug!
                </p>
            </div>

       <div class="info-container" data-aos="fade-up">
    <Experience Title="My Experience" Items="@aboutExperienceItems">
        <Icon>
            <i class="fa-solid fa-star"></i>
        </Icon>
    </Experience>
    
    <WhatsNext Title="What's Next" Items="@aboutWhatsNextItems">
        <Icon>
            <i class="fa-solid fa-road"></i>
        </Icon>
    </WhatsNext>
</div>


        </div>
    </div>
</section>
@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; }


private readonly string[] aboutExperienceItems = new[]
{
    "Kattmatch – Cat adoption platform in production, built and operated solo (2025–present)",
    "AI & Python Development (2026) – EC Utbildning",
    ".NET Fullstack Developer Education (2023–2025) – EC Utbildning",
    "Internship @ Edument / Akribian – Admin portal with React, TypeScript & Node.js",
    "Swedish Customs – Case officer since 2015; wrote the requirements spec for a new warehouse system"
};

private readonly string[] aboutWhatsNextItems = new[]
{
    "Looking for my first developer role, ideally .NET or full-stack",
    "Kattmatch – expanding beyond the pilot to more organizations",
    "Deepening my .NET and backend skills in a team, with people to learn from"
};

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await JS.InvokeVoidAsync("initAOS");
    }
}