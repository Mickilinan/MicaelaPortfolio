@page "/projects"
@inject ProjectService projectService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Projects | Micaela Nilsson</PageTitle>

<ProjectGridBase>
    <div class="page-header">
        <h1>Projects</h1>
        <p>A showcase of my work</p>
    </div>

    <section class="projects-section">
        <div class="projects-grid">
            @foreach (var project in filteredProjects)
            {
                <ProjectCard Project="project" 
                            AosDelay="@(project.Id * 100)" 
                            MaxTechnologies="10"
                            OnProjectClick="OpenProject" />
            }
        </div>
    </section>
</ProjectGridBase>

<ProjectModal Project="selectedProject" IsVisible="isModalVisible" OnClose="CloseModal" />

@code {
    private List<Project> filteredProjects = new List<Project>();
    private Project? selectedProject;
    private bool isModalVisible = false;

    protected override void OnInitialized()
    {
        filteredProjects = projectService.GetProjects();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initAOS");
        }
    }

    private async Task OpenProject(Project project)
    {
        if (project.Screenshots?.Any() == true)
        {
            selectedProject = project;
            isModalVisible = true;
        }
        else
        {
            string urlToOpen = !string.IsNullOrEmpty(project.LiveUrl) ? project.LiveUrl : project.GitHubUrl;
            if (!string.IsNullOrEmpty(urlToOpen))
            {
                await JSRuntime.InvokeVoidAsync("open", urlToOpen, "_blank");
            }
        }
    }

    private void CloseModal()
    {
        selectedProject = null;
        isModalVisible = false;
    }
}